# Build-time only. Every VITE_* value is public; never put secrets here.
#
# VITE_ENV selects exactly one address book:
#   dev  → src/config/deployments/anvil31337_dev.json
#   test → src/config/deployments/bscTestnet_test.json
#   prod → src/config/deployments/bscMainnet_prod.json
VITE_ENV=dev

# GitHub project pages: /<repo>/ ; custom domain: /
VITE_BASE=/

# Absolute origin for canonical/og:url (optional locally).
# VITE_SITE_ORIGIN=https://example.github.io

# Dev-only RPC override (anvil on a non-default port, e.g. when another project
# already owns 127.0.0.1:8545). Ignored by the test/prod address books.
# VITE_ANVIL_RPC=http://127.0.0.1:8545
